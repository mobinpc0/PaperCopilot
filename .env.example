# -------------------------------------------------------------
# Google Gemini (Free: https://aistudio.google.com/app/apikey)
# -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# -------------------------------------------------------------
# Groq (Free: https://console.groq.com/keys)
# llama-3.1-8b-instant has universal free tier access
# -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# -------------------------------------------------------------
# OpenRouter (Free: https://openrouter.ai/keys)
# 'openrouter/free' automatically selects an active free model
# -------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# -------------------------------------------------------------
# GitHub Models (Free: https://github.com/settings/tokens)
# Free GPT-4o mini with personal access token
# -------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# Anthropic Claude (Optional / Paid)
# -------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_HAIKU_MODEL=claude-haiku-5-5
CLAUDE_SONNET_MODEL=claude-sonnet-5-5
